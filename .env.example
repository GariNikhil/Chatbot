# Chatbot Environment Configuration

# Server Configuration
HOST=127.0.0.1
PORT=3001

# LLM Provider Configuration
# Choose your provider: 'lmstudio' (default) or 'ollama'
LLM_PROVIDER=lmstudio

# LLM Base URL (OpenAI-compatible)
# For LM Studio (default): http://127.0.0.1:1234/v1
# For Ollama: http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1

# Provider-specific URLs (alternative to LLM_BASE_URL)
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Default Model
# LM Studio: use model name as loaded (e.g., qwen3-4b)
# Ollama: use model name with tag (e.g., qwen3:4b, llama3.1:8b)
LLM_MODEL=local-model
# LMSTUDIO_MODEL=local-model
# OLLAMA_MODEL=qwen3:4b

# CORS Origin
CORS_ORIGIN=http://localhost:3001

# Request body size limit (bytes)
MAX_BODY_BYTES=1048576

# Memory/Obsidian Configuration
# Path to your Obsidian vault (memories will be stored in <vault>/Chatbot/Memories)
# Leave empty to use workspace/memory/Chatbot/Memories
OBSIDIAN_VAULT_PATH=

# Optional: Override house directory location
# AI_HOUSE_ROOT=/path/to/house
